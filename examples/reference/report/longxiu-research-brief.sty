\newcommand{\BriefAxisScores}[5]{%
  {\fontsize{6.2}{7.2}\selectfont\color{BriefMuted}
  Scalability #1/5 \enspace|\enspace Uncertainty #2/5 \enspace|\enspace Flexibility #3/5\par
  Ease of use #4/5 \enspace|\enspace Interpretability #5/5}}

% Fixed-axis radar chart. Scores describe intellectual emphasis, not quality. --
\newcommand{\BriefRadar}[5]{%
\begin{tikzpicture}[x=1cm,y=1cm]
  \foreach \level in {1,...,5}{%
    \pgfmathsetmacro{\rr}{0.22*\level}
    \draw[BriefBorder,line width=.35pt] (90:\rr)--(18:\rr)--(-54:\rr)--(-126:\rr)--(162:\rr)--cycle;
  }
  \foreach \ang in {90,18,-54,-126,162}{\draw[BriefBorder,line width=.35pt] (0,0)--(\ang:1.10);}
  \pgfmathsetmacro{\ra}{0.22*#1}
  \pgfmathsetmacro{\rb}{0.22*#2}
  \pgfmathsetmacro{\rc}{0.22*#3}
  \pgfmathsetmacro{\rd}{0.22*#4}
  \pgfmathsetmacro{\re}{0.22*#5}
  \path[fill=BriefPaleGreen,draw=BriefGreen,line width=1.0pt]
    (90:\ra)--(18:\rb)--(-54:\rc)--(-126:\rd)--(162:\re)--cycle;
  \foreach \ang/\rad in {90/\ra,18/\rb,-54/\rc,-126/\rd,162/\re}
    \fill[BriefOchreRule] (\ang:\rad) circle (1.25pt);
  \node[font=\fontsize{5.6}{6.1}\selectfont\bfseries,text=BriefMuted,anchor=south] at (90:1.35) {Scalability};
  \node[font=\fontsize{5.6}{6.1}\selectfont\bfseries,text=BriefMuted,anchor=west] at (18:1.39) {Uncertainty};
  \node[font=\fontsize{5.6}{6.1}\selectfont\bfseries,text=BriefMuted,anchor=north west] at (-54:1.35) {Flexibility};
  \node[font=\fontsize{5.6}{6.1}\selectfont\bfseries,text=BriefMuted,anchor=north east] at (-126:1.35) {Ease of use};
  \node[font=\fontsize{5.6}{6.1}\selectfont\bfseries,text=BriefMuted,anchor=east] at (162:1.39) {Interpretability};
\end{tikzpicture}}

\newcommand{\BriefRadarPanel}[5]{%
  \begin{center}
    \BriefRadar{#1}{#2}{#3}{#4}{#5}\par\vspace{-2pt}
    \BriefAxisScores{#1}{#2}{#3}{#4}{#5}
  \end{center}}

