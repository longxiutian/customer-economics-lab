{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "Source files are separate CSV exports with documented keys. DuckDB executes saved SQL locally; no database server is required.",
        "customer_month and cohort_age_summary supply retained customers and revenue; cohort_cash_economics adds acquisition cost and cash recovery.",
        "experiment_person keeps every randomized prospect, including nonbuyers; experiment_effects uses each test's own control and outcome window."
      ],
      "title": "Saved evidence, not a hidden answer"
    },
    {
      "dot": "orange",
      "items": [
        "The source-tables ERD retains every field, key and cardinality; the UCV appendix identifies available and missing kinds of customer evidence.",
        "One person has many periods, transactions, events and responses. Aggregate daily campaign spending before joining acquired customers.",
        "A model forecasts future value; it cannot turn attribution credit or an observed cohort trend into an incremental campaign effect."
      ],
      "title": "Read alongside the detailed schema"
    }
  ],
